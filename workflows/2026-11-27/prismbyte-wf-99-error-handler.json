    {
      "id": "69d2a482-9e67-485d-bd56-eb7fcd550b84",
      "name": "Prepare Correlated Error Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const base = $('Normalize Error Event').first().json; const match = $input.first()?.json || {}; const found = !!match.request_id && String(match.execution_id || '') === String(base.execution_id || ''); return [{json:{...base,request_id:found?String(match.request_id):'',article_id:found?String(match.article_id || ''):'',request_found:found}}];"
      }
    },
    {
      "id": "fe402f76-5fad-4cf9-9733-e76e2d5484a5",
      "name": "Prepare Request Failure Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
