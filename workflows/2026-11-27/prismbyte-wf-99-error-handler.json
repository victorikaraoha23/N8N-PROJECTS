        1500,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $('Prepare Correlated Error Event').first().json; if (!item.request_found || !item.request_id) return []; return [{json:{request_id:String(item.request_id),last_error:'Workflow failure at ' + String(item.node_name || 'unknown node') + ': ' + String(item.message || 'Unknown error'),updated_at:String(item.occurred_at || new Date().toISOString())}}];"
      }
