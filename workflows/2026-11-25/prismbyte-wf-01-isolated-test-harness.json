    {
      "id": "e5c078ad-35cd-413e-8559-39a20190764f",
      "name": "Validate Simulated Telegram Decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2580,
        760
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const now=Date.now();\nreturn $input.all().map(x=>{\n const row=x.json;\n const command=(row.article_id==='PB-ISOLATED-APPROVE-001'?'/approve ':'/reject ')+row.article_id;\n const msg={text:command,chat:{id:7392605484,type:'private'},from:{id:7392605484}};\n const parts=String(msg.text||'').trim().split(' ').filter(Boolean);\n const cmd=String(parts[0]||'').split('@')[0].toLowerCase();\n const parsed={decision:cmd==='/approve'?'approve':cmd==='/reject'?'reject':'',article_id:String(parts[1]||'').trim()};\n const authorized=String(msg.chat.id)==='7392605484'&&String(msg.from.id)==='7392605484'&&msg.chat.type==='private';\n const valid=/^PB-[A-Za-z0-9_-]+$/.test(parsed.article_id);\n if(!authorized||!valid||!parsed.decision||parsed.article_id!==row.article_id||row.qa_status!=='PASS'||row.review_status!=='pending_review'||!Number.isFinite(Date.parse(row.deadline_at))||now>=Date.parse(row.deadline_at)) throw new Error('Decision validation failed for '+row.article_id);\n return {json:{article_id:row.article_id,review_status:parsed.decision==='approve'?'approved':'rejected',decision_at:new Date(now).toISOString(),decision_source:'telegram',publish_status:parsed.decision==='approve'?'approved_waiting_publish':'blocked_rejected'}};\n});"
      }
