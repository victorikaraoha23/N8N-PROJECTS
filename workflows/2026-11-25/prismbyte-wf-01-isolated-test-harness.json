    {
      "id": "42027046-99b1-464f-a630-a7eecda74898",
      "name": "Assert Persisted Test Decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        760
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows=$input.all().map(x=>x.json);const expected={'PB-ISOLATED-APPROVE-001':['approved','approved_waiting_publish'],'PB-ISOLATED-REJECT-001':['rejected','blocked_rejected']};const checks=[];for(const [id,s] of Object.entries(expected)){const r=rows.find(x=>x.article_id===id);checks.push({name:id+' persisted',passed:!!r},{name:id+' decision state',passed:!!r&&r.review_status===s[0]&&r.publish_status===s[1]},{name:id+' Telegram source',passed:!!r&&r.decision_source==='telegram'});let ids=[];try{ids=JSON.parse(r?.telegram_message_ids||'[]')}catch{}checks.push({name:id+' delivery IDs',passed:!!r&&r.telegram_delivery_status==='delivered'&&ids.length===2&&ids.every(Number.isInteger)});const sent=Date.parse(r?.review_sent_at||'');const deadline=Date.parse(r?.deadline_at||'');checks.push({name:id+' exact 12-hour deadline',passed:Number.isFinite(sent)&&Number.isFinite(deadline)&&deadline===sent+12*60*60*1000});}const failed=checks.filter(x=>!x.passed);return [{json:{suite:'Prismbyte isolated Telegram + persistent review queue integration',total:checks.length,passed:checks.length-failed.length,failed:failed.length,result:failed.length?'FAIL':'PASS',checks,records:rows.map(x=>({article_id:x.article_id,review_status:x.review_status,publish_status:x.publish_status,telegram_delivery_status:x.telegram_delivery_status,telegram_message_ids:x.telegram_message_ids,review_sent_at:x.review_sent_at,deadline_at:x.deadline_at,decision_at:x.decision_at,decision_source:x.decision_source}))}}];"
      }
