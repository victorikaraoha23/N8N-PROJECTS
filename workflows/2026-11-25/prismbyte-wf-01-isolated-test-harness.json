        "jsCode": "const getId=name=>{const x=$(name).first().json;const id=x.result?.message_id??x.message_id;if(!Number.isInteger(id))throw new Error(name+' did not return message_id');return id;}; const ids=[getId('Send Test Review Summary'),getId('Send Test Review Instructions')];const now=Date.now();return $('Prepare Test Review Records').all().map(x=>({json:{article_id:x.json.article_id,telegram_delivery_status:'delivered',telegram_message_ids:JSON.stringify(ids),review_sent_at:new Date(now).toISOString(),deadline_at:new Date(now+12*60*60*1000).toISOString()}}));"
