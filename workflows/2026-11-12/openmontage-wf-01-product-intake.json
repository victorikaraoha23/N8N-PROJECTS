    {
      "id": "fb406050-ecf4-4b47-8a04-dcb76e0c2492",
      "name": "Authorize and Validate URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        360
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const update=$input.first()?.json??{};\nconst message=update.message??update;\nconst senderId=String(message.from?.id??'');\nconst chatId=String(message.chat?.id??'');\nconst text=String(message.text??'').trim();\nconst isResearch=/^\\/research(?:@\\w+)?(?:\\s|$)/i.test(text);\nconst researchCommand=/^\\/research(?:@\\w+)?$/i.test(text);\nconst html=value=>String(value??'').replace(/[&<>\"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[ch]));\nif(senderId!=='7392605484'||message.chat?.type!=='private')return[];\nif(/^\\/cancel(?:@\\w+)?(?:\\s|$)/i.test(text))return[{json:{action:'cancel',chatId,senderId}}];\nif(/^\\/add(?:@\\w+)?(?:\\s|$)/i.test(text))return[{json:{action:'prompt',chatId,senderId}}];\nconst candidateText=isResearch?text.replace(/^\\/research(?:@\\w+)?/i,'').trim():text;\nconst matches=candidateText.match(/https?:\\/\\/[^\\s<>]+/gi)??[];\nlet rawUrl='';\nif(matches.length===1&&candidateText.replace(matches[0],'').trim()===''){\n  rawUrl=matches[0].replace(/[),.!?]+$/,'');\n}else if(matches.length===0&&candidateText){\n  const bareCandidate=candidateText.replace(/[),.!?]+$/,'');\n  const bareDomainPattern=/^(?:www\\.)?(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}(?::\\d+)?(?:[/?#][^\\s<>]*)?$/i;\n  if(bareDomainPattern.test(bareCandidate))rawUrl='https://'+bareCandidate;\n}\nif(!rawUrl){\n  if(researchCommand&&candidateText==='')return[{json:{action:'research',status:'prompt',chatId,senderId}}];\n  return[{json:{action:isResearch?'research':'invalid',status:'invalid',chatId,senderId,reason:isResearch?'Send one complete public product URL or domain, for example:\\nhttps://example.com/':'I couldn’t find one complete product URL.\\n\\nSend /add to start, then send a single website address such as:\\nhttps://example.com'}}];\n}\nconst match=rawUrl.match(/^(https?):\\/\\/([^/?#]+)([\\s\\S]*)$/i);\nif(!match)return[{json:{action:isResearch?'research':'invalid',status:'invalid',chatId,senderId,reason:'That address doesn’t look like a valid website URL. Please use https:// or http://.'}}];\nconst protocol=match[1].toLowerCase(),authority=match[2],remainder=match[3]??'';\nif(authority.includes('@')||authority.startsWith('['))return[{json:{action:isResearch?'research':'invalid',status:'invalid',chatId,senderId,reason:'Please use a public website domain, not a private or IP address.'}}];\nconst host=authority.split(':')[0].toLowerCase(),isIp=/^\\d{1,3}(\\.\\d{1,3}){3}$/.test(host),labels=host.split('.'),validDomain=labels.length>=2&&labels.every(label=>label.length>=1&&label.length<=63&&/^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/.test(label)),blockedHost=host==='localhost'||host.endsWith('.localhost')||host.endsWith('.local'),portMatch=authority.match(/:(\\d+)$/),validPort=!portMatch||(Number(portMatch[1])>=1&&Number(portMatch[1])<=65535);\nif(isIp||!validDomain||blockedHost||!validPort||!/^[a-z0-9.-]+(?::\\d+)?$/i.test(authority))return[{json:{action:isResearch?'research':'invalid',status:'invalid',chatId,senderId,reason:'Please use a public website domain, not a private or IP address.'}}];\nconst withoutFragment=remainder.split('#')[0],normalizedRemainder=withoutFragment===''||withoutFragment.startsWith('?')?'/'+withoutFragment:withoutFragment,canonicalUrl=protocol+'://'+authority.toLowerCase()+normalizedRemainder,productName=host.replace(/^www\\./,'');\nreturn[{json:{action:isResearch?'research':'process',status:'valid',chatId,senderId,canonicalUrl,productName,safeProductName:html(productName),safeCanonicalUrl:html(canonicalUrl)}}];"
      }
    },
