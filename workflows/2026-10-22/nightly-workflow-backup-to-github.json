      "parameters": {
        "jsCode": "const data = $input.first().json.data || [];\nconst today = new Date().toISOString().slice(0, 10);\nreturn data.map(wf => {\n  const slug = wf.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || `workflow-${wf.id}`;\n  return { json: {\n    path: `workflows/${today}/${slug}.json`,\n    content: JSON.stringify({ name: wf.name, nodes: wf.nodes, connections: wf.connections, settings: wf.settings }, null, 2),\n    message: `backup: ${wf.name}`\n  } };\n});"
      },
