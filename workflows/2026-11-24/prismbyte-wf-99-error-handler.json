      "name": "Normalize Error Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const e = $input.first()?.json ?? {};\nconst execution = e.execution ?? {};\nconst workflow = e.workflow ?? {};\nconst error = e.error ?? {};\nconst now = new Date().toISOString();\nconst executionId = String(execution.id ?? 'unknown');\nreturn [{ json: { event_id: 'ERR-' + executionId, workflow_id: String(workflow.id ?? 'unknown'), execution_id: executionId, request_id: String(e.request_id ?? ''), article_id: String(e.article_id ?? ''), event_type: 'workflow_execution_failed', severity: 'error', node_name: String(execution.lastNodeExecuted ?? error.node?.name ?? 'unknown'), message: String(error.message ?? error.description ?? 'Workflow failed without an error message'), occurred_at: now, resolved: false } }];"
      }
    },
