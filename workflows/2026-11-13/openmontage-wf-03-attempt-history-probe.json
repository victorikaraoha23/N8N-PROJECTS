    {
      "id": "11f5ca25-fcd0-427b-9b50-a9d3529515b7",
      "name": "Assert Probe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const x=$input.first().json,h=x.attempt_history||[],e=h.map(v=>v.provider+':'+v.event); if(x.status!=='completed'||Number(x.primary_attempts)!==1||Number(x.recovery_attempts)!==1||!e.includes('openrouter:failed')||!e.includes('nvidia:succeeded'))throw new Error('Attempt history did not persist: '+JSON.stringify(x)); return [{json:{passed:true,events:e}}];"
      }
    },
