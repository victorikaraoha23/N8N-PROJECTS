    {
      "id": "e1a5104d-e887-4c69-bd38-46be09ce3f3f",
      "name": "Validate Checkpoint Readback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows=$input.all().map(x=>x.json||{}); if(rows.length!==1) throw new Error('Expected exactly one test checkpoint row; found '+rows.length); const row=rows[0]; const result=typeof row.result==='string'?JSON.parse(row.result):row.result; const checks={status:row.status==='completed',provider:row.provider_used==='nvidia',recoveryAttempts:Number(row.recovery_attempts)===1,resultObject:!!result&&typeof result==='object',batchId:result?.batchId==='om-test-batch-0001',candidateIds:JSON.stringify(result?.expectedCandidateIds)===JSON.stringify(['om-test-candidate-1'])&&JSON.stringify(result?.classifiedIds)===JSON.stringify(['om-test-candidate-1']),runId:result?.researchRunId===$('Create Isolated Test Research Run').item.json.id}; const failed=Object.entries(checks).filter(([k,v])=>!v).map(([k])=>k); if(failed.length) throw new Error('Checkpoint persistence checks failed: '+failed.join(', ')); return [{json:{testPassed:true,checks,rowId:row.id,runId:row.research_run_id,batchId:row.batch_id}}];"
      }
    },
